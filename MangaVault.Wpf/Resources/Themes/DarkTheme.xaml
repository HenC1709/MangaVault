<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Colores obligatorios de la identidad visual MangaVault -->
  <Color x:Key="BackgroundColor">#0B0D12</Color>
  <Color x:Key="SidebarColor">#11131B</Color>
  <Color x:Key="SurfaceColor">#171923</Color>
  <Color x:Key="ElevatedSurfaceColor">#242735</Color>
  <Color x:Key="PrimaryAccentColor">#8B5CF6</Color>
  <Color x:Key="PrimaryHoverColor">#A78BFA</Color>
  <Color x:Key="SecondaryAccentColor">#22D3EE</Color>
  <Color x:Key="SuccessColor">#34D399</Color>
  <Color x:Key="WarningColor">#F59E0B</Color>
  <Color x:Key="ErrorColor">#F87171</Color>
  <Color x:Key="PrimaryTextColor">#F3F4F6</Color>
  <Color x:Key="SecondaryTextColor">#9CA3AF</Color>
  <Color x:Key="BorderColor">#303443</Color>

  <!-- Tintes translúcidos derivados para estados, badges y superposiciones -->
  <Color x:Key="PrimarySubtleColor">#268B5CF6</Color>
  <Color x:Key="SecondarySubtleColor">#2222D3EE</Color>
  <Color x:Key="SuccessSubtleColor">#2234D399</Color>
  <Color x:Key="WarningSubtleColor">#22F59E0B</Color>
  <Color x:Key="ErrorSubtleColor">#24F87171</Color>
  <Color x:Key="ModalBackdropColor">#B80B0D12</Color>

  <!-- Brushes principales -->
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource ElevatedSurfaceColor}" />
  <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
  <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

  <!-- Brushes derivados -->
  <SolidColorBrush x:Key="PrimarySubtleBrush" Color="{StaticResource PrimarySubtleColor}" />
  <SolidColorBrush x:Key="SecondarySubtleBrush" Color="{StaticResource SecondarySubtleColor}" />
  <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}" />
  <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}" />
  <SolidColorBrush x:Key="ErrorSubtleBrush" Color="{StaticResource ErrorSubtleColor}" />
  <SolidColorBrush x:Key="ModalBackdropBrush" Color="{StaticResource ModalBackdropColor}" />

  <!-- Tipografía -->
  <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
  <sys:Double x:Key="FontSizeTitle">26</sys:Double>
  <sys:Double x:Key="FontSizeSubtitle">18</sys:Double>
  <sys:Double x:Key="FontSizeBody">14</sys:Double>
  <sys:Double x:Key="FontSizeSecondary">12.5</sys:Double>

</ResourceDictionary>

<UserControl x:Class="MangaVault.Wpf.Views.FavoritesView"
             x:Name="RootFavorites"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24,20,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Barra de filtro de favoritos -->
    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Limpiar filtro"
                  Style="{StaticResource GhostButtonStyle}"
                  Command="{Binding ClearFilterCommand}"
                  Margin="0,0,10,0" />
          <Button Content="Actualizar"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding RefreshCommand}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Estado de lectura:"
                     Style="{StaticResource SecondaryTextStyle}"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0" />
          <ComboBox Width="220"
                    Style="{StaticResource DarkComboBoxStyle}"
                    ItemsSource="{Binding ReadingStatusFilterOptions}"
                    SelectedItem="{Binding SelectedReadingStatusFilter}"
                    DisplayMemberPath="Label" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ProgressBar Grid.Row="1"
                 Style="{StaticResource DarkProgressBarStyle}"
                 IsIndeterminate="True"
                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                 Margin="0,0,0,12" />

    <Border Grid.Row="2"
            Style="{StaticResource ErrorBannerStyle}"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
            Margin="0,0,0,12">
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{StaticResource ErrorBrush}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Estado vacío o vista de 2 columnas -->
    <Grid Grid.Row="3">
      <Border Style="{StaticResource EmptyStateCardStyle}"
              Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
              VerticalAlignment="Top">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="No tienes favoritos en esta vista"
                     Style="{StaticResource SectionTitleTextStyle}"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,8" />
          <TextBlock Text="Marca tus mangas o novelas ligeras con ★ desde Biblioteca para seguir su progreso aquí."
                     Style="{StaticResource SecondaryTextStyle}"
                     TextAlignment="Center"
                     MaxWidth="420" />
        </StackPanel>
      </Border>

      <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="400" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0"
                 Style="{StaticResource MangaCardListBoxStyle}"
                 ItemsSource="{Binding Favorites}"
                 SelectedItem="{Binding SelectedFavorite, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="56"
                        Height="80"
                        CornerRadius="8"
                        Background="{StaticResource PrimarySubtleBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">
                  <Grid>
                    <TextBlock Text="{Binding Monogram}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryHoverBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Image Source="{Binding CoverPath, Converter={StaticResource CoverPathToImageConverter}}"
                           Stretch="UniformToFill" />
                  </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}"
                             FontSize="15.5"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap" />
                  <TextBlock Text="{Binding Author}"
                             Style="{StaticResource SecondaryTextStyle}"
                             Margin="0,2,0,8"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap" />

                  <WrapPanel>
                    <Border Style="{StaticResource BadgeBorderStyle}"
                            Background="{Binding ReadingStatusAccentKey, Converter={StaticResource AccentKeyToSubtleBrushConverter}}"
                            Margin="0,0,6,4">
                      <TextBlock Text="{Binding ReadingStatusLabel}"
                                 FontSize="11.5"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding ReadingStatusAccentKey, Converter={StaticResource AccentKeyToBrushConverter}}" />
                    </Border>
                    <Border Style="{StaticResource BadgeBorderStyle}"
                            Background="{StaticResource ElevatedSurfaceBrush}"
                            Margin="0,0,6,4">
                      <TextBlock Text="{Binding ProgressDisplay}" FontSize="11.5" />
                    </Border>
                    <Border Style="{StaticResource BadgeBorderStyle}"
                            Background="{StaticResource PrimarySubtleBrush}"
                            Margin="0,0,0,4">
                      <TextBlock Text="{Binding RatingDisplay}"
                                 FontSize="11.5"
                                 Foreground="{StaticResource PrimaryHoverBrush}" />
                    </Border>
                  </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                  <Button Content="+1 cap"
                          Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding DataContext.IncrementChapterCommand, ElementName=RootFavorites}"
                          CommandParameter="{Binding}"
                          Padding="10,6"
                          Margin="0,0,8,0" />
                  <Button Content="★"
                          Style="{StaticResource GhostButtonStyle}"
                          Foreground="{StaticResource WarningBrush}"
                          FontSize="16"
                          ToolTip="Quitar de favoritos"
                          Command="{Binding DataContext.UnfavoriteCommand, ElementName=RootFavorites}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
            <StackPanel Visibility="{Binding HasSelectedFavorite, Converter={StaticResource BoolToVisibilityConverter}}">
              <TextBlock Text="{Binding SelectedFavorite.Title}"
                         Style="{StaticResource SectionTitleTextStyle}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedFavorite.Author}"
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,2,0,10" />

              <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4">
                    <Run Text="Tipo: " />
                    <Run Text="{Binding SelectedFavorite.TypeBadge, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" />
                  </TextBlock>
                  <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4">
                    <Run Text="Capítulos totales: " />
                    <Run Text="{Binding SelectedFavorite.FinalChapters, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" />
                  </TextBlock>
                  <TextBlock Style="{StaticResource SecondaryTextStyle}">
                    <Run Text="Agregada: " />
                    <Run Text="{Binding SelectedFavorite.DateAddedDisplay, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" />
                  </TextBlock>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource ErrorBannerStyle}"
                      Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibilityConverter}}"
                      Margin="0,0,0,12">
                <TextBlock Text="{Binding DetailErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" />
              </Border>

              <TextBlock Text="Estado de lectura" Style="{StaticResource FieldLabelTextStyle}" />
              <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                        ItemsSource="{Binding ReadingStatusOptions}"
                        SelectedItem="{Binding EditReadingStatusOption}"
                        DisplayMemberPath="Label"
                        Margin="0,0,0,12" />

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Capítulo actual" Style="{StaticResource FieldLabelTextStyle}" />
                  <TextBox Style="{StaticResource DarkTextBoxStyle}"
                           Text="{Binding EditCurrentChapterText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Tomos poseídos" Style="{StaticResource FieldLabelTextStyle}" />
                  <TextBox Style="{StaticResource DarkTextBoxStyle}"
                           Text="{Binding EditOwnedVolumesText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>

              <TextBlock Text="Calificación" Style="{StaticResource FieldLabelTextStyle}" />
              <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                        ItemsSource="{Binding RatingOptions}"
                        SelectedItem="{Binding EditRatingOption}"
                        DisplayMemberPath="Label"
                        Margin="0,0,0,16" />

              <Button Content="Guardar progreso"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding SaveProgressCommand}"
                      Margin="0,0,0,10" />

              <Button Content="Quitar de favoritos"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding UnfavoriteCommand}"
                      Margin="0,0,0,10" />

              <Button Content="Quitar de mi biblioteca"
                      Style="{StaticResource DestructiveButtonStyle}"
                      Command="{Binding RemoveFromLibraryCommand}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

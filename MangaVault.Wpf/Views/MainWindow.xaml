<Window x:Class="MangaVault.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MangaVault.Wpf.Views"
        xmlns:models="clr-namespace:MangaVault.Wpf.ViewModels.Models"
        Title="MangaVault"
        Width="1360"
        Height="820"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
  <Grid>
    <!-- Pantalla de autenticación -->
    <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
      <views:AuthView DataContext="{Binding AuthViewModel}" />
    </Grid>

    <!-- Shell principal autenticado -->
    <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Barra lateral -->
      <Border Grid.Column="0"
              Background="{StaticResource SidebarBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,1,0"
              Padding="16,20">
        <DockPanel>
          <!-- Marca -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,6,26">
            <Border Width="38"
                    Height="38"
                    CornerRadius="10"
                    Background="{StaticResource PrimaryAccentBrush}"
                    Margin="0,0,12,0">
              <TextBlock Text="MV"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="MangaVault"
                         FontSize="17"
                         FontWeight="Bold"
                         Foreground="{StaticResource PrimaryTextBrush}" />
              <TextBlock Text="Biblioteca personal"
                         Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
          </StackPanel>

          <!-- Pie con usuario activo -->
          <Border DockPanel.Dock="Bottom"
                  Style="{StaticResource ElevatedCardStyle}"
                  Padding="12">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="36"
                        Height="36"
                        CornerRadius="10"
                        Background="{StaticResource PrimarySubtleBrush}"
                        BorderBrush="{StaticResource PrimaryAccentBrush}"
                        BorderThickness="1">
                  <TextBlock Text="{Binding CurrentUserInitial}"
                             FontWeight="Bold"
                             Foreground="{StaticResource PrimaryHoverBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CurrentUserName}"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap" />
                  <TextBlock Text="{Binding CurrentUserRole}"
                             Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
              </Grid>

              <Button Content="Cerrar sesión"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Padding="10,7"
                      Command="{Binding SignOutCommand}" />
            </StackPanel>
          </Border>

          <!-- Navegación principal (solo secciones funcionales) -->
          <StackPanel>
            <TextBlock Text="NAVEGACIÓN"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="12,0,0,8" />

            <Button Content="Dashboard"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    Tag="{Binding IsDashboardActive}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.Dashboard}" />

            <Button Content="Biblioteca"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    Tag="{Binding IsLibraryActive}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.Library}" />

            <Button Content="Favoritos"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    Tag="{Binding IsFavoritesActive}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.Favorites}" />

            <Button Content="Configuración"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    Tag="{Binding IsSettingsActive}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.Settings}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Área principal -->
      <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado superior -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,16">
          <DockPanel>
            <Border DockPanel.Dock="Right"
                    Style="{StaticResource BadgeBorderStyle}"
                    Background="{StaticResource PrimarySubtleBrush}"
                    BorderBrush="{StaticResource PrimaryAccentBrush}"
                    BorderThickness="1"
                    Padding="12,6"
                    VerticalAlignment="Center">
              <TextBlock FontSize="12.5" FontWeight="Medium">
                <Run Text="{Binding CurrentUserName, Mode=OneWay}" />
                <Run Text=" · " Foreground="{StaticResource SecondaryTextBrush}" />
                <Run Text="{Binding CurrentUserRole, Mode=OneWay}" Foreground="{StaticResource PrimaryHoverBrush}" />
              </TextBlock>
            </Border>

            <StackPanel>
              <TextBlock Text="{Binding CurrentPage.Title}"
                         Style="{StaticResource PageTitleTextStyle}" />
              <TextBlock Text="{Binding CurrentPage.Subtitle}"
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Contenido dinámico -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
      </Grid>
    </Grid>

    <!-- Toast de notificaciones -->
    <Border HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="24"
            MaxWidth="440"
            Background="{StaticResource ElevatedSurfaceBrush}"
            BorderBrush="{Binding Notification.Kind, Converter={StaticResource AccentKeyToBrushConverter}}"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="16,12"
            Visibility="{Binding Notification.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Content="✕"
                Style="{StaticResource GhostButtonStyle}"
                Padding="6,2"
                Margin="12,0,0,0"
                Command="{Binding Notification.DismissCommand}" />
        <TextBlock Text="{Binding Notification.Message}"
                   Style="{StaticResource BodyTextStyle}"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>
  </Grid>
</Window>

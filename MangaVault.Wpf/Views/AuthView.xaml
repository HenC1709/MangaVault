<UserControl x:Class="MangaVault.Wpf.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <UserControl.Resources>
    <sys:Boolean x:Key="TrueValue">True</sys:Boolean>
    <sys:Boolean x:Key="FalseValue">False</sys:Boolean>
  </UserControl.Resources>

  <Grid Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid MinHeight="640" Margin="24">
        <Border Style="{StaticResource CardBorderStyle}"
                MaxWidth="440"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="32">
          <StackPanel>
            <!-- Encabezado de marca MangaVault -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
              <Border Width="42"
                      Height="42"
                      CornerRadius="10"
                      Background="{StaticResource PrimaryAccentBrush}"
                      Margin="0,0,12,0">
                <TextBlock Text="MV"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MangaVault"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="Biblioteca personal · SQLite"
                           Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </StackPanel>

            <!-- Selector de modo -->
            <Grid Margin="0,0,0,22">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0"
                      Content="Iniciar sesión"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding SwitchModeCommand}"
                      CommandParameter="{StaticResource FalseValue}"
                      Click="SwitchMode_Click" />
              <Button Grid.Column="2"
                      Content="Crear cuenta"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding SwitchModeCommand}"
                      CommandParameter="{StaticResource TrueValue}"
                      Click="SwitchMode_Click" />
            </Grid>

            <TextBlock Text="{Binding ModeHeading}"
                       Style="{StaticResource PageTitleTextStyle}"
                       Margin="0,0,0,6" />
            <TextBlock Text="{Binding ModeDescription}"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,0,0,22" />

            <!-- Banner de error -->
            <Border Style="{StaticResource ErrorBannerStyle}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0,0,0,16">
              <TextBlock Text="{Binding ErrorMessage}"
                         Foreground="{StaticResource ErrorBrush}"
                         TextWrapping="Wrap" />
            </Border>

            <!-- Usuario -->
            <TextBlock Text="Nombre de usuario" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox x:Name="UsernameInput"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsNotBusy}"
                     Margin="0,0,0,14" />

            <!-- Contraseña -->
            <TextBlock Text="Contraseña" Style="{StaticResource FieldLabelTextStyle}" />
            <PasswordBox x:Name="PasswordInput"
                         Style="{StaticResource DarkPasswordBoxStyle}"
                         Margin="0,0,0,14" />

            <!-- Confirmar contraseña en registro -->
            <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,0,14">
              <TextBlock Text="Confirmar contraseña" Style="{StaticResource FieldLabelTextStyle}" />
              <PasswordBox x:Name="ConfirmPasswordInput"
                           Style="{StaticResource DarkPasswordBoxStyle}" />
            </StackPanel>

            <!-- Indicador de carga -->
            <ProgressBar Style="{StaticResource DarkProgressBarStyle}"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="0,0,0,14" />

            <Button Content="{Binding PrimaryButtonText}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    IsEnabled="{Binding IsNotBusy}"
                    Click="Submit_Click"
                    Margin="0,4,0,14" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock Text="{Binding SwitchModePrompt}"
                         Style="{StaticResource SecondaryTextStyle}"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0" />
              <Button Content="{Binding SwitchModeButtonText}"
                      Style="{StaticResource GhostButtonStyle}"
                      Foreground="{StaticResource PrimaryHoverBrush}"
                      Click="ToggleMode_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>

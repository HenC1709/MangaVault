<UserControl x:Class="MangaVault.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
    <StackPanel Margin="28,24,28,28">
      <!-- Barra superior de estado -->
      <DockPanel Margin="0,0,0,18">
        <Button DockPanel.Dock="Right"
                Content="Actualizar"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding RefreshCommand}" />
        <TextBlock Text="Datos sincronizados directamente desde SQLite"
                   Style="{StaticResource SecondaryTextStyle}"
                   VerticalAlignment="Center" />
      </DockPanel>

      <ProgressBar Style="{StaticResource DarkProgressBarStyle}"
                   IsIndeterminate="True"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                   Margin="0,0,0,16" />

      <Border Style="{StaticResource ErrorBannerStyle}"
              Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
              Margin="0,0,0,18">
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap" />
      </Border>

      <!-- Tarjetas KPI -->
      <UniformGrid Columns="4" Margin="0,0,0,20">
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Catálogo total" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Text="{Binding TotalWorks}" Style="{StaticResource KpiValueTextStyle}" Margin="0,6,0,6" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}">
              <Run Text="{Binding MangaCount, Mode=OneWay}" />
              <Run Text=" mangas · " />
              <Run Text="{Binding LightNovelCount, Mode=OneWay}" />
              <Run Text=" novelas" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="En mi biblioteca" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Text="{Binding LibraryCount}" Style="{StaticResource KpiValueTextStyle}" Margin="0,6,0,6" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}">
              <Run Text="{Binding TotalOwnedVolumes, Mode=OneWay}" />
              <Run Text=" tomos en colección" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Favoritos" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Text="{Binding FavoritesCount}"
                       Style="{StaticResource KpiValueTextStyle}"
                       Foreground="{StaticResource PrimaryHoverBrush}"
                       Margin="0,6,0,6" />
            <TextBlock Text="Obras marcadas en tu lista" Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <TextBlock Text="Calificación promedio" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Text="{Binding AverageRatingDisplay}"
                       Style="{StaticResource KpiValueTextStyle}"
                       Foreground="{StaticResource SecondaryAccentBrush}"
                       Margin="0,6,0,6" />
            <TextBlock Text="Sobre obras calificadas" Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Distribución real por estado -->
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <TextBlock Text="Estado de publicación" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,14" />
            <ItemsControl ItemsSource="{Binding PublicationBreakdown}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,12">
                    <DockPanel Margin="0,0,0,5">
                      <TextBlock DockPanel.Dock="Right"
                                 Text="{Binding Count}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource PrimaryTextBrush}" />
                      <TextBlock Text="{Binding Label}" Style="{StaticResource BodyTextStyle}" />
                    </DockPanel>
                    <Border x:Name="Track"
                            Height="8"
                            CornerRadius="4"
                            Background="{StaticResource ElevatedSurfaceBrush}">
                      <Border HorizontalAlignment="Left"
                              Height="8"
                              CornerRadius="4"
                              Background="{Binding AccentKey, Converter={StaticResource AccentKeyToBrushConverter}}">
                        <Border.Width>
                          <MultiBinding Converter="{StaticResource RatioToWidthMultiConverter}">
                            <Binding Path="Ratio" />
                            <Binding ElementName="Track" Path="ActualWidth" />
                          </MultiBinding>
                        </Border.Width>
                      </Border>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <TextBlock Text="Progreso de lectura" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,14" />
            <ItemsControl ItemsSource="{Binding ReadingBreakdown}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,12">
                    <DockPanel Margin="0,0,0,5">
                      <TextBlock DockPanel.Dock="Right"
                                 Text="{Binding Count}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource PrimaryTextBrush}" />
                      <TextBlock Text="{Binding Label}" Style="{StaticResource BodyTextStyle}" />
                    </DockPanel>
                    <Border x:Name="Track"
                            Height="8"
                            CornerRadius="4"
                            Background="{StaticResource ElevatedSurfaceBrush}">
                      <Border HorizontalAlignment="Left"
                              Height="8"
                              CornerRadius="4"
                              Background="{Binding AccentKey, Converter={StaticResource AccentKeyToBrushConverter}}">
                        <Border.Width>
                          <MultiBinding Converter="{StaticResource RatioToWidthMultiConverter}">
                            <Binding Path="Ratio" />
                            <Binding ElementName="Track" Path="ActualWidth" />
                          </MultiBinding>
                        </Border.Width>
                      </Border>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Favoritos recientes -->
      <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel>
          <TextBlock Text="Favoritos recientes" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,14" />

          <TextBlock Text="Todavía no has marcado obras como favoritas. Puedes hacerlo desde la sección Biblioteca."
                     Style="{StaticResource SecondaryTextStyle}"
                     Visibility="{Binding HasNoFavorites, Converter={StaticResource BoolToVisibilityConverter}}" />

          <ItemsControl ItemsSource="{Binding RecentFavorites}"
                        Visibility="{Binding HasNoFavorites, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,12,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="52" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="52"
                            Height="72"
                            CornerRadius="8"
                            Background="{StaticResource PrimarySubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            ClipToBounds="True">
                      <Grid>
                        <TextBlock Text="{Binding Monogram}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryHoverBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Image Source="{Binding CoverPath, Converter={StaticResource CoverPathToImageConverter}}"
                               Stretch="UniformToFill" />
                      </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap" />
                      <TextBlock Text="{Binding Author}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap"
                                 Margin="0,2,0,6" />
                      <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource BadgeBorderStyle}"
                                Background="{Binding ReadingStatusAccentKey, Converter={StaticResource AccentKeyToSubtleBrushConverter}}"
                                Margin="0,0,8,0">
                          <TextBlock Text="{Binding ReadingStatusLabel}"
                                     FontSize="11.5"
                                     FontWeight="SemiBold"
                                     Foreground="{Binding ReadingStatusAccentKey, Converter={StaticResource AccentKeyToBrushConverter}}" />
                        </Border>
                        <TextBlock Text="{Binding ProgressDisplay}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

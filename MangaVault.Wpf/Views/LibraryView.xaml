<UserControl x:Class="MangaVault.Wpf.Views.LibraryView"
             x:Name="RootLibrary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <!-- Contenido principal de Biblioteca -->
    <Grid Margin="24,20,24,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Barra de búsqueda y filtros -->
      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Buscar obra por título">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
              </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="2"
                    Content="Buscar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding SearchCommand}" />

            <Button Grid.Column="4"
                    Content="Limpiar"
                    Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding ClearFiltersCommand}"
                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Button Grid.Column="6"
                    Content="+ Nueva obra"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding OpenCreateWorkCommand}" />
          </Grid>

          <WrapPanel Grid.Row="2" Orientation="Horizontal">
            <StackPanel Margin="0,0,12,0" Width="190">
              <TextBlock Text="Tipo de obra" Style="{StaticResource FieldLabelTextStyle}" />
              <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                        ItemsSource="{Binding MediaTypeOptions}"
                        SelectedItem="{Binding SelectedMediaTypeOption}"
                        DisplayMemberPath="Label" />
            </StackPanel>

            <StackPanel Margin="0,0,12,0" Width="190">
              <TextBlock Text="Estado de publicación" Style="{StaticResource FieldLabelTextStyle}" />
              <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                        ItemsSource="{Binding MangaStatusOptions}"
                        SelectedItem="{Binding SelectedStatusOption}"
                        DisplayMemberPath="Label" />
            </StackPanel>

            <StackPanel Margin="0,0,12,0" Width="200">
              <TextBlock Text="Género" Style="{StaticResource FieldLabelTextStyle}" />
              <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                        ItemsSource="{Binding AvailableGenres}"
                        SelectedItem="{Binding SelectedGenre}" />
            </StackPanel>

            <Button Content="Actualizar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Bottom"
                    Command="{Binding RefreshCommand}" />
          </WrapPanel>
        </Grid>
      </Border>

      <ProgressBar Grid.Row="1"
                   Style="{StaticResource DarkProgressBarStyle}"
                   IsIndeterminate="True"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                   Margin="0,0,0,12" />

      <Border Grid.Row="2"
              Style="{StaticResource ErrorBannerStyle}"
              Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
              Margin="0,0,0,12">
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap" />
      </Border>

      <!-- Lista de obras + panel lateral de detalle -->
      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="400" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Lista o estado vacío -->
        <Grid Grid.Column="0">
          <Border Style="{StaticResource EmptyStateCardStyle}"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                  VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="Sin resultados en el catálogo"
                         Style="{StaticResource SectionTitleTextStyle}"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,8" />
              <TextBlock Text="No hay obras que coincidan con la búsqueda o aún no agregas ninguna obra."
                         Style="{StaticResource SecondaryTextStyle}"
                         TextAlignment="Center"
                         MaxWidth="380"
                         Margin="0,0,0,16" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Limpiar filtros"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearFiltersCommand}"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,10,0" />
                <Button Content="+ Nueva obra"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding OpenCreateWorkCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ListBox Style="{StaticResource MangaCardListBoxStyle}"
                   ItemsSource="{Binding Works}"
                   SelectedItem="{Binding SelectedWork, Mode=TwoWay}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Portada o monograma -->
                  <Border Grid.Column="0"
                          Width="58"
                          Height="82"
                          CornerRadius="8"
                          Background="{StaticResource PrimarySubtleBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          ClipToBounds="True">
                    <Grid>
                      <TextBlock Text="{Binding Monogram}"
                                 FontSize="17"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource PrimaryHoverBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                      <Image Source="{Binding CoverPath, Converter={StaticResource CoverPathToImageConverter}}"
                             Stretch="UniformToFill" />
                    </Grid>
                  </Border>

                  <!-- Datos de la obra -->
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding Author}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,2,0,8"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <Border Style="{StaticResource BadgeBorderStyle}"
                              Background="{StaticResource ElevatedSurfaceBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              Margin="0,0,6,4">
                        <TextBlock Text="{Binding TypeBadge}" FontSize="11.5" />
                      </Border>

                      <Border Style="{StaticResource BadgeBorderStyle}"
                              Background="{Binding StatusAccentKey, Converter={StaticResource AccentKeyToSubtleBrushConverter}}"
                              Margin="0,0,6,4">
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusAccentKey, Converter={StaticResource AccentKeyToBrushConverter}}" />
                      </Border>

                      <Border Style="{StaticResource BadgeBorderStyle}"
                              Background="{Binding ReadingStatusAccentKey, Converter={StaticResource AccentKeyToSubtleBrushConverter}}"
                              Visibility="{Binding HasEntry, Converter={StaticResource BoolToVisibilityConverter}}"
                              Margin="0,0,6,4">
                        <TextBlock Text="{Binding ReadingStatusLabel}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding ReadingStatusAccentKey, Converter={StaticResource AccentKeyToBrushConverter}}" />
                      </Border>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                      <Run Text="{Binding VolumeCount, Mode=OneWay}" />
                      <Run Text=" tomos · " />
                      <Run Text="{Binding FinalChapters, Mode=OneWay}" />
                      <Run Text=" caps · " />
                      <Run Text="{Binding GenresSummary, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>

                  <!-- Acceso rápido a favorito + progreso -->
                  <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=RootLibrary}"
                            CommandParameter="{Binding}"
                            ToolTip="Marcar o quitar favorito"
                            Padding="8,4"
                            HorizontalAlignment="Right">
                      <TextBlock FontSize="18">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="☆" />
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter Property="Text" Value="★" />
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Button>
                    <TextBlock Text="{Binding ProgressDisplay}"
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Right"
                               Margin="0,6,0,0" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <!-- Panel de detalle y seguimiento personal -->
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
            <Grid>
              <TextBlock Text="Selecciona una obra de la lista para ver sus detalles, editarla o registrar tu progreso de lectura."
                         Style="{StaticResource SecondaryTextStyle}"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="{Binding HasSelectedWork, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

              <StackPanel Visibility="{Binding HasSelectedWork, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- Cabecera de detalle -->
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0"
                          Width="78"
                          Height="110"
                          CornerRadius="10"
                          Background="{StaticResource PrimarySubtleBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          ClipToBounds="True">
                    <Grid>
                      <TextBlock Text="{Binding SelectedWork.Monogram}"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource PrimaryHoverBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                      <Image Source="{Binding SelectedWork.CoverPath, Converter={StaticResource CoverPathToImageConverter}}"
                             Stretch="UniformToFill" />
                    </Grid>
                  </Border>

                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedWork.Title}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedWork.Author}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,3,0,2" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{Binding SelectedWork.HasIllustrator, Converter={StaticResource BoolToVisibilityConverter}}">
                      <Run Text="Ilustrador: " />
                      <Run Text="{Binding SelectedWork.Illustrator, Mode=OneWay}" />
                    </TextBlock>

                    <WrapPanel Margin="0,8,0,0">
                      <Border Style="{StaticResource BadgeBorderStyle}"
                              Background="{StaticResource ElevatedSurfaceBrush}"
                              Margin="0,0,6,4">
                        <TextBlock Text="{Binding SelectedWork.TypeBadge}" FontSize="11.5" />
                      </Border>
                      <Border Style="{StaticResource BadgeBorderStyle}"
                              Background="{Binding SelectedWork.StatusAccentKey, Converter={StaticResource AccentKeyToSubtleBrushConverter}}"
                              Margin="0,0,0,4">
                        <TextBlock Text="{Binding SelectedWork.StatusLabel}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding SelectedWork.StatusAccentKey, Converter={StaticResource AccentKeyToBrushConverter}}" />
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                </Grid>

                <!-- Acciones de catálogo -->
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0"
                          Content="Editar obra"
                          Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding OpenEditSelectedWorkCommand}" />
                  <Button Grid.Column="2"
                          Content="Eliminar"
                          Style="{StaticResource DestructiveButtonStyle}"
                          Command="{Binding DeleteSelectedWorkCommand}" />
                </Grid>

                <!-- Metadatos -->
                <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,0,16">
                  <StackPanel>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="Tomos" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding SelectedWork.VolumeCount}" FontWeight="SemiBold" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Capítulos totales" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding SelectedWork.FinalChapters}" FontWeight="SemiBold" />
                      </StackPanel>
                    </Grid>

                    <TextBlock Text="Géneros" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{Binding SelectedWork.GenresSummary}"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,2,0,8" />

                    <StackPanel Visibility="{Binding SelectedWork.HasSynopsis, Converter={StaticResource BoolToVisibilityConverter}}">
                      <TextBlock Text="Sinopsis" Style="{StaticResource SecondaryTextStyle}" />
                      <TextBlock Text="{Binding SelectedWork.Synopsis}"
                                 Style="{StaticResource BodyTextStyle}"
                                 Margin="0,2,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Seguimiento personal (FavoriteService) -->
                <TextBlock Text="Mi seguimiento personal"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Margin="0,0,0,12" />

                <Border Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,0,12">
                  <TextBlock Text="{Binding DetailErrorMessage}"
                             Foreground="{StaticResource ErrorBrush}"
                             TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="Estado de lectura" Style="{StaticResource FieldLabelTextStyle}" />
                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                          ItemsSource="{Binding ReadingStatusOptions}"
                          SelectedItem="{Binding EntryReadingStatusOption}"
                          DisplayMemberPath="Label"
                          Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Capítulo actual" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding EntryCurrentChapterText, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Tomos poseídos" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding EntryOwnedVolumesText, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="Calificación" Style="{StaticResource FieldLabelTextStyle}" />
                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                          ItemsSource="{Binding RatingOptions}"
                          SelectedItem="{Binding EntryRatingOption}"
                          DisplayMemberPath="Label"
                          Margin="0,0,0,12" />

                <CheckBox Style="{StaticResource DarkCheckBoxStyle}"
                          Content="Marcar como favorita"
                          IsChecked="{Binding EntryIsFavorite}"
                          Margin="0,0,0,16" />

                <Button Content="{Binding TrackButtonText}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveTrackingCommand}"
                        Margin="0,0,0,10" />

                <Button Content="Quitar de mi biblioteca"
                        Style="{StaticResource DestructiveButtonStyle}"
                        Command="{Binding RemoveFromLibraryCommand}"
                        Visibility="{Binding SelectedWorkInLibrary, Converter={StaticResource BoolToVisibilityConverter}}" />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- Modal de creación / edición de obra -->
    <Grid Background="{StaticResource ModalBackdropBrush}"
          Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
      <Border Style="{StaticResource CardBorderStyle}"
              MaxWidth="660"
              MaxHeight="740"
              Margin="24"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="22,16">
            <DockPanel>
              <Button DockPanel.Dock="Right"
                      Content="Cerrar"
                      Style="{StaticResource GhostButtonStyle}"
                      Command="{Binding CancelEditorCommand}" />
              <TextBlock Text="{Binding EditorTitle}"
                         Style="{StaticResource SectionTitleTextStyle}"
                         VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
            <StackPanel>
              <Border Style="{StaticResource ErrorBannerStyle}"
                      Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibilityConverter}}"
                      Margin="0,0,0,14">
                <TextBlock Text="{Binding FormErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" />
              </Border>

              <TextBlock Text="Título *" Style="{StaticResource FieldLabelTextStyle}" />
              <TextBox Style="{StaticResource DarkTextBoxStyle}"
                       Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,0,0,12" />

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Tipo de obra" Style="{StaticResource FieldLabelTextStyle}" />
                  <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                            ItemsSource="{Binding FormTypeOptions}"
                            SelectedItem="{Binding FormTypeOption}"
                            DisplayMemberPath="Label" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Estado de publicación" Style="{StaticResource FieldLabelTextStyle}" />
                  <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                            ItemsSource="{Binding FormStatusOptions}"
                            SelectedItem="{Binding FormStatusOption}"
                            DisplayMemberPath="Label" />
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Autor / Mangaka" Style="{StaticResource FieldLabelTextStyle}" />
                  <TextBox Style="{StaticResource DarkTextBoxStyle}"
                           Text="{Binding FormAuthor, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Ilustrador (opcional)" Style="{StaticResource FieldLabelTextStyle}" />
                  <TextBox Style="{StaticResource DarkTextBoxStyle}"
                           Text="{Binding FormIllustrator, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Tomos totales" Style="{StaticResource FieldLabelTextStyle}" />
                  <TextBox Style="{StaticResource DarkTextBoxStyle}"
                           Text="{Binding FormVolumeCountText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Capítulos totales (0 si es desconocido)" Style="{StaticResource FieldLabelTextStyle}" />
                  <TextBox Style="{StaticResource DarkTextBoxStyle}"
                           Text="{Binding FormFinalChaptersText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>

              <TextBlock Text="Portada local (opcional)" Style="{StaticResource FieldLabelTextStyle}" />
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Text="{Binding FormCoverPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2"
                        Content="Examinar..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BrowseCoverCommand}" />
              </Grid>

              <TextBlock Text="Géneros (separados por coma)" Style="{StaticResource FieldLabelTextStyle}" />
              <TextBox Style="{StaticResource DarkTextBoxStyle}"
                       Text="{Binding FormGenresText, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,0,0,10" />

              <ItemsControl ItemsSource="{Binding SeededGenres}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding}"
                            Style="{StaticResource GenreChipButtonStyle}"
                            Command="{Binding DataContext.ToggleFormGenreCommand, ElementName=RootLibrary}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="Sinopsis (opcional)" Style="{StaticResource FieldLabelTextStyle}" />
              <TextBox Style="{StaticResource DarkTextBoxStyle}"
                       Text="{Binding FormSynopsis, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalContentAlignment="Top"
                       Height="88" />
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="2"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Cancelar"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding CancelEditorCommand}"
                      Margin="0,0,10,0" />
              <Button Content="Guardar obra"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding SaveWorkCommand}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
